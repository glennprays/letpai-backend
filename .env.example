# ── App ────────────────────────────────────────────────
ENV=development
APP_NAME=letpai
APP_PORT=3000

# ── Logging ────────────────────────────────────────────
LOG_LEVEL=debug            # debug | info | warn | error
LOG_OUTPUT=stdout          # stdout | stderr | file

# ── PostgreSQL ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=dev_letpai

# ── JWT & OTP ──────────────────────────────────────────
JWT_SECRET=changeme-in-production
JWT_EXPIRY_HOURS=168       # 7 days
OTP_EXPIRY_MINUTES=5

# ── Frontend URL ───────────────────────────────────────
# Used to build payment links in WhatsApp notifications
APP_URL=http://localhost:4001

# ── WhatsApp Gateway ───────────────────────────────────
WHATSAPP_GATEWAY_URL=http://localhost:8080
WHATSAPP_API_KEY=
WHATSAPP_WEBHOOK_SECRET=

# ── Redis ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── AWS S3 (image uploads) ────────────────────────────
# Leave AWS_ENDPOINT empty for standard AWS S3
AWS_ENDPOINT=               # e.g. https://minio.example.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=letpai-uploads
CDN_URL=                    # e.g. https://cdn.example.com/letpai-uploads
ENABLE_WEBP=true
WEBP_QUALITY=85
MAX_IMAGE_SIZE_MB=5
